<div class="item grid">
    <div class="poster">
        <img src="@Movie.PosterUrl" alt="Poster" />
    </div>

    <div class="info">
        <div class="title">@Movie.Title (@Movie.Year)</div>
        <div class="meta">@Movie.GenreText</div>
        <div class="meta">@Movie.Runtime min</div>
    </div>

    <div class="actions">
        <button class="btn btn-sm btn-primary"
                @onclick="() => OnShowDetails.InvokeAsync(Movie.Id)">
            Details
        </button>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public MovieOverviewData Movie { get; set; } = default!;
    [Parameter] public EventCallback<Guid> OnShowDetails { get; set; }
}
