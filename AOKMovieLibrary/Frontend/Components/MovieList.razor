@page "/movies"
@inject IMovieService MovieService
@inject IJSRuntime JS



<h4>Movies Overview</h4>

@if (_loading)
{
    <p>Lade…</p>
}
else if (_movies.Count == 0)
{
    <p>Keine Filme vorhanden.</p>
}
else
{
    
    <div style="max-width: 340px;">
        @foreach (var movie in _movies)
        {
            <MovieListItem Movie="movie" OnShowDetails="HandleShowDetails" />
        }
    </div>
}
<hr />

<h4>Edit Movies</h4>

@if (_editableMovies is null || _editableMovies.Count == 0)
{
    <p>Keine editierbaren Movies geladen.</p>
}
else
{
    <div class="p-3 border rounded" style="max-width: 900px;">
        @foreach (var m in _editableMovies)
        {
            <div class="border rounded p-2 mb-3">
                <div class="d-flex justify-content-between align-items-center">
                    <strong>@m.Name</strong>                 
                </div>

                <div class="row g-2 mt-1">
                    <div class="col-md-4">
                        <label class="form-label">Name</label>
                        <input class="form-control"
                               @bind-value="m.Name"
                               @bind-value:event="oninput"
                               @bind-value:after="RefreshOverview" />



                    </div>

                    <div class="col-md-2">
                        <label class="form-label">Year</label>
                        <input class="form-control" type="number"
                               @bind-value="m.ReleaseYear"
                               @bind-value:event="oninput"
                               @bind-value:after="RefreshOverview" />
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">Runtime (min)</label>
                        <input class="form-control" type="number"
                               @bind-value="m.DurationMinutes"
                               @bind-value:event="oninput"
                               @bind-value:after="RefreshOverview" />
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">Rating</label>
                        <input class="form-control" type="number" step="0.1"
                               @bind-value="m.Rating"
                               @bind-value:event="oninput"
                               @bind-value:after="RefreshOverview" />
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">Poster</label>
                        <input class="form-control" @bind="m.PosterFileName" />
                    </div>
                </div>

                <div class="mt-2">
                    <label class="form-label">Genre (Flags)</label>
                    <div class="d-flex flex-wrap gap-3">
                        @foreach (var g in _availableGenres)
                        {
                            <label class="d-flex align-items-center gap-1">
                                <input type="checkbox"
                                       checked="@HasGenre(m.Genre, g)"
                                       @onchange="() => ToggleGenre(m, g)" />
                                <span>@g</span>
                            </label>
                        }

                    </div>
                    
                </div>
            </div>
        }
    </div>
}

@foreach (var item in EventType)
{
    <p>@item</p>
    <hr />
}




@code {
    private bool _loading = true;
    private List<MovieOverviewData> _movies = new();
    private List<AOKMovieLibrary.Models.DAL.Movie> _editableMovies = new();
    List<string> EventType = new List<string>();


    protected override async Task OnInitializedAsync()
    {
        EventType.Add("OnInitializedAsync is called");
        _loading = true;

        var data = await MovieService.GetAllOverviewAsync();
        _movies = data.ToList();
        _editableMovies = await MovieService.GetEditableMoviesAsync();

        _loading = false;
    }
    private readonly List<AOKMovieLibrary.Models.DAL.MovieGenre> _availableGenres =
    Enum.GetValues<AOKMovieLibrary.Models.DAL.MovieGenre>()
        .Where(g => g != AOKMovieLibrary.Models.DAL.MovieGenre.None)
        .ToList();

    private static bool HasGenre(AOKMovieLibrary.Models.DAL.MovieGenre current,
                             AOKMovieLibrary.Models.DAL.MovieGenre flag)
     => (current & flag) == flag;

    private void ToggleGenre(AOKMovieLibrary.Models.DAL.Movie movie,
                         AOKMovieLibrary.Models.DAL.MovieGenre flag)
    {
        if (HasGenre(movie.Genre, flag))
            movie.Genre &= ~flag;   // remove
        else
            movie.Genre |= flag;    // add

        RefreshOverview();          
    }

    protected override void OnInitialized()
    {
        EventType.Add("OnInitialized is called");
    }
    protected override void OnParametersSet()
    {
        EventType.Add("OnParametersSet is called");
    }
    protected override async Task OnParametersSetAsync()
    {

        EventType.Add("OnParametersSetAsync is called");
    }
    protected override void OnAfterRender(bool firstRender)
    {
        EventType.Add("OnAfterRender is called");
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        EventType.Add("OnAfterRenderAsync is called");
    }

    private async Task HandleShowDetails(Guid movieId)
    {
       
        await JS.InvokeVoidAsync("console.log", $"Navigate to movie details: {movieId}");
    }
    private void RefreshOverview()
    {
        _movies = _editableMovies
            .OrderBy(x => x.Name)
            .Select(x => AOKMovieLibrary.Models.ViewModels.MovieOverviewDataMapping.MapToMovieOverviewData(x))
            .ToList();

        StateHasChanged();
    }
   

    






}
